platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# THMR 的 file_picker 用于导出文本文件。
Pod::PICKER_MEDIA = false
Pod::PICKER_AUDIO = false

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  settings = File.join(__dir__, 'Flutter', 'Generated.xcconfig')
  unless File.exist?(settings)
    raise "#{settings} is missing. Run flutter pub get first."
  end

  File.foreach(settings) do |line|
    match = line.match(/^FLUTTER_ROOT=(.*)$/)
    return match[1].strip if match
  end
  raise "FLUTTER_ROOT is missing from #{settings}. Run flutter pub get again."
end

require File.join(flutter_root, 'packages', 'flutter_tools', 'bin', 'podhelper')

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  pod 'thmr_mp3', :path => '../native'

  flutter_install_all_ios_pods __dir__
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
